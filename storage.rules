rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Get user's profile from Firestore to check their company
    function perteneceAEmpresa(empresaId) {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.empresaId == empresaId;
    }

    // Restrict access to files within the empresa folder
    match /empresas/{empresaId}/{allPaths=**} {
      allow read, write: if perteneceAEmpresa(empresaId);
    }
  }
}
